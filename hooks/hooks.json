{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PLUGIN_ROOT:-}/hooks/session-start.sh\"; [ -f \"$s\" ] || exit 0; exec sh \"$s\""
          }
        ]
      }
    ]
  }
}
